</ParagraphStyleRange>
<Br />
<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Paragraph">
  <CharacterStyleRange AppliedCharacterStyle="$ID/NormalCharacterStyle">
    <Content>Aspetta che eventi esterni (missioni, conseguenze) spostino naturalmente i tracciatori. Intanto sopporti le penalità.</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
