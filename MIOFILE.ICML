    <HyperlinkTextDestination Self="HyperlinkTextDestination/#lista-completa-delle-abilità-con-gli-attributi-di-prova-associati" Name="Destination" DestinationUniqueKey="1" />
    <Content>Lista completa delle abilità (con gli attributi di prova associati)</Content>
  </CharacterStyleRange>
</ParagraphStyleRange>
